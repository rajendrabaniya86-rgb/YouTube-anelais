# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Free stock media: https://www.pexels.com/api/
PEXELS_API_KEY=

# YouTube OAuth desktop client (Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Produced by: python scripts/authorize_youtube.py
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# Channel setup
CHANNEL_TOPIC=technology and productivity tips
CHANNEL_LANGUAGE=hi
UPLOAD_PRIVACY=public
DAILY_SHORTS=1
DAILY_LONGS=0
POST_HOUR_UTC=6
ENABLE_SCHEDULER=true
# Set when the dashboard is not bound to localhost; then open /?token=<value>
DASHBOARD_TOKEN=
